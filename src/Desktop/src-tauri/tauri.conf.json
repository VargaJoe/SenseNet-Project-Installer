{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plot Manager",
  "version": "0.1.0",
  "identifier": "io.github.vargajoe.plotmanager",
  "build": {
    "frontendDist": "../bootstrap"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "shortDescription": "Project, plot and run management",
    "longDescription": "Shared Plot Manager UI with its local ASP.NET Core service and native PowerShell runner.",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/service/": "service/",
      "resources/engine/": "engine/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libssl3", "libicu74"] }
    }
  }
}
